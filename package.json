{
  "name": "cardbox",
  "version": "1.0.2",
  "author": "xiaolu511",
  "description": "AI 卡片笔记",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:app": "electron-builder"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cardbox.desktop",
    "productName": "Cardbox",
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server/src/**/*",
      "server/package.json",
      "!server/.env",
      "web/dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  }
}
